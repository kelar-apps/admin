# Copy this file to .env and fill in the values (see README.md).

# OAuth Client ID (Web application) — the same one the Kelar apps use.
VITE_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com

# URL of the deployed "Kelar Lisensi" Apps Script web app (ends with /exec).
VITE_LICENSE_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Products shown in the form, comma separated. "semua" (all products) is always added.
VITE_PRODUCTS=tracker-lamaran

# Base path for the build. Use "/" locally; on GitHub Pages use "/<repo-name>/".
VITE_BASE=/
